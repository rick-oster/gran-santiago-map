{
  "name": "gran-santiago-map",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Gran Santiago Map V1 — M0 infrastructure scaffold (no geographic data yet)",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:static": "node scripts/check-m0.mjs",
    "test:unit": "vitest run",
    "test:unit:ci": "vitest run --reporter=json --outputFile=evidence/vitest.json",
    "test:e2e": "playwright test",
    "verify:quick": "npm run check:static && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
